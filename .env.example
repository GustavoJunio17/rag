# === Embeddings ===
GEMINI_API_KEY=sua-chave-aqui

# OpenAI (alternativa — mude config.embedding.provider para "openai")
# OPENAI_API_KEY=sk-...

# Voyage (alternativa — mude config.embedding.provider para "voyage")
# VOYAGE_API_KEY=...

# === PostgreSQL ===
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=gestores_ia
PG_USER=postgres
PG_PASSWORD=postgres

# === Azure Storage (opcional) ===
# AZURE_STORAGE_CONNECTION_STRING=...
